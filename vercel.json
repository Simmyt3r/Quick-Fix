{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    {
      "src": "/static/sw.js",
      "dest": "/api/index.py",
      "headers": {
        "Cache-Control": "no-cache",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/static/manifest.webmanifest",
      "dest": "/api/index.py",
      "headers": {
        "Content-Type": "application/manifest+json"
      }
    },
    { "src": "/static/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)",        "dest": "/api/index.py" }
  ]
}
