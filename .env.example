FLASK_ENV=development
SECRET_KEY=change-me

# DATABASE_URL is now read by the app (app/__init__.py). If unset, it falls
# back to a local SQLite file at instance/quickfix.db — fine for dev, but
# every deploy target needs a real Postgres URL here.
#
# Neon (https://neon.tech): copy the connection string from your project's
# dashboard. It looks like the line below. Either "postgres://" or
# "postgresql://" works — the app normalizes it.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/quickfix?sslmode=require

# After setting DATABASE_URL, create the schema with:
#   flask db upgrade
# (see migrations/ — Flask-Migrate/Alembic manages schema changes from here on)

# Google OAuth — read by app/__init__.py. Create a Web application OAuth
# client at https://console.cloud.google.com/apis/credentials and add this
# exact URL under "Authorized redirect URIs" (swap the host for your real
# domain in production — it must match exactly, including http vs https):
#   http://localhost:5000/google-callback
#
# If either of these is unset, the app still runs fine — the "Continue with
# Google" button just doesn't render, and /login/google flashes an error
# instead of crashing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Not yet read by the code — added ahead of later phases (see TODO.md)

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hugging Face
HUGGINGFACE_API_TOKEN=

MAIL_FROM=noreply@quickfix.ng
MAIL_ADMIN=admin@quickfix.ng

# Password reset emails, via Gmail SMTP. SMTP_PASSWORD must be a Gmail App
# Password (Google Account -> Security -> 2-Step Verification -> App
# Passwords) — a normal Gmail password will not work over SMTP.
# If either is unset, the app still runs fine — the reset link is logged to
# the server console instead of emailed, so the flow stays testable locally.
SMTP_USERNAME=
SMTP_PASSWORD=

# Mapbox — geocoding (turning a typed address into lat/lng) and the map UI.
# This is a PUBLIC token by design (starts with pk.), safe to expose in
# client-side JS — Mapbox's own docs recommend restricting it by URL in
# your Mapbox account dashboard rather than treating it as a secret.
# If unset, the app still runs fine — a request just saves with no
# coordinates, and distance-sorted matching falls back to the existing
# category-only order.
MAPBOX_ACCESS_TOKEN=

# Pusher — powers live location updates (a professional's position while
# available, and while working an in_progress job). Server-side secret;
# treat PUSHER_SECRET like any other API secret. If unset, the app still
# runs fine — location sharing/tracking is just unavailable, same
# graceful-degradation pattern as every other optional integration here.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
