FLASK_ENV=development
SECRET_KEY=change-me

# DATABASE_URL is now read by the app (app/__init__.py). If unset, it falls
# back to a local SQLite file at instance/quickfix.db — fine for dev, but
# every deploy target needs a real Postgres URL here.
#
# Neon (https://neon.tech): copy the connection string from your project's
# dashboard. It looks like the line below. Either "postgres://" or
# "postgresql://" works — the app normalizes it.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/quickfix?sslmode=require

# After setting DATABASE_URL, create the schema with:
#   flask db upgrade
# (see migrations/ — Flask-Migrate/Alembic manages schema changes from here on)

# Not yet read by the code — added ahead of later phases (see TODO.md)

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hugging Face
HUGGINGFACE_API_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5000/google-callback

MAIL_FROM=noreply@quickfix.ng
MAIL_ADMIN=admin@quickfix.ng
